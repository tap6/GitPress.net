---
import { getCollection, render } from "astro:content";
import Base from "../layouts/Base.astro";
import { postSlug, withBase, type Page } from "../lib/gitpress";

export async function getStaticPaths() {
  const pages = await getCollection("pages");
  const real = pages.map((page) => ({
    params: { slug: postSlug(page) },
    props: { page, redirectTo: null as string | null },
  }));
  const redirects = pages.flatMap((page) => {
    const current = postSlug(page);
    return (page.data.redirectFrom ?? [])
      .map(String)
      .filter((oldSlug) => oldSlug && oldSlug !== current)
      .map((oldSlug) => ({
        params: { slug: oldSlug },
        props: { page: null as Page | null, redirectTo: withBase(`/${current}/`) },
      }));
  });
  return [...real, ...redirects];
}

interface Props {
  page: Page | null;
  redirectTo: string | null;
}

const { page, redirectTo } = Astro.props;
if (redirectTo) return Astro.redirect(redirectTo, 301);
if (!page) return Astro.redirect(withBase("/"), 302);
const { Content } = await render(page);
---

<Base title={page.data.title} description={page.data.description}>
  <article data-pagefind-body>
    <h1 class="page-heading">{page.data.title}</h1>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>
