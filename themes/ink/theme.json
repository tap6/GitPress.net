{
  "specVersion": 1,
  "name": "ink",
  "version": "1.0.0",
  "displayName": "Ink",
  "description": "Dark, bold, card-based magazine theme for night owls.",
  "author": "GitPress",
  "license": "MIT",
  "engine": "astro",
  "preview": "preview.svg",
  "tags": ["dark", "cards", "magazine"],
  "configSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "accentColor": {
        "type": "string",
        "default": "#f59e0b",
        "description": "Accent color for links and highlights."
      },
      "showCovers": {
        "type": "boolean",
        "default": true,
        "description": "Show cover images on post cards."
      }
    },
    "additionalProperties": true
  }
}
