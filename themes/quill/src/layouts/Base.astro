---
import { getCollection } from "astro:content";
import { gitpress, themeConfig, withBase, buildNav, buildFooter, mediaHref, pageCanonicalUrl, pageAbsoluteUrl } from "../lib/gitpress";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  cover?: string;
  type?: "website" | "article";
  publishedTime?: string;
}

const { title, description, cover, type = "website", publishedTime } = Astro.props;
const site = gitpress.site;
const pageTitle = title ? `${title} · ${site.title}` : site.title;
const desc = description ?? site.description ?? "";
const canonicalUrl = pageCanonicalUrl(Astro.url.pathname);
const ogImageHref = pageAbsoluteUrl(cover) ?? pageAbsoluteUrl(site.logo) ?? pageAbsoluteUrl(site.avatar);
const jsonLd =
  type === "article"
    ? {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        headline: title ?? site.title,
        description: desc || undefined,
        datePublished: publishedTime,
        image: ogImageHref,
        url: canonicalUrl,
        author: site.author ? { "@type": "Person", name: site.author } : undefined,
      }
    : {
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: site.title,
        description: desc || undefined,
        url: site.url || canonicalUrl,
      };
const navPages = await getCollection("pages");
const navLinks = buildNav(navPages);
const footerEntries = buildFooter(navPages);
const logoHref = mediaHref(site.logo);
const avatarHref = mediaHref(site.avatar);
const showLogo = themeConfig.showLogo !== false && Boolean(logoHref);
const showAvatar = themeConfig.showAvatar === true && Boolean(avatarHref);
const showTitle = themeConfig.showTitle !== false || !showLogo;
const showTagline = themeConfig.showTagline !== false;
const faviconHref = logoHref ?? avatarHref;
---

<!doctype html>
<html lang={site.language ?? "en"} style={`--accent: ${themeConfig.accentColor}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <meta name="generator" content="GitPress" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {ogImageHref && <meta property="og:image" content={ogImageHref} />}
    <meta name="twitter:card" content={ogImageHref ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={desc} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={site.title}
      href={withBase("/rss.xml")}
    />
    {faviconHref && <link rel="icon" href={faviconHref} />}
    {site.analyticsSnippet && <Fragment set:html={site.analyticsSnippet} />}
    <script is:inline define:vars={{ defaultAppearance: themeConfig.defaultAppearance }}>
      // Runs before paint so there is no light->dark flash. Priority: the
      // visitor's own saved choice, then this site's configured default,
      // then their OS preference.
      (function () {
        var STORAGE_KEY = "quill-appearance";
        var mode = localStorage.getItem(STORAGE_KEY) || defaultAppearance;
        if (mode === "system") {
          mode = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }
        document.documentElement.dataset.theme = mode;
      })();
    </script>
  </head>
  <body>
    <header class="site-header" data-pagefind-ignore>
      <div class="site-brand">
        {showAvatar && avatarHref && <img class="site-avatar" src={avatarHref} alt="" width="48" height="48" />}
        <div class="site-brand-copy">
          {
            showLogo && logoHref && (
              <a href={withBase("/")} class="site-logo-link">
                <img class="site-logo" src={logoHref} alt={showTitle ? "" : site.title} />
              </a>
            )
          }
          {showTitle && (
            <p class="site-title">
              <a href={withBase("/")}>{site.title}</a>
            </p>
          )}
        </div>
      </div>
      <button type="button" id="theme-toggle" class="theme-toggle" aria-label="Toggle light/dark appearance">
        <svg viewBox="0 0 20 20" fill="currentColor" class="icon-sun"><path d="M10 4a1 1 0 0 1 1 1v1a1 1 0 1 1-2 0V5a1 1 0 0 1 1-1zm0 4a4 4 0 1 1 0 8 4 4 0 0 1 0-8zm7 3a1 1 0 1 1 0 2h-1a1 1 0 1 1 0-2h1zM4 11a1 1 0 1 1 0 2H3a1 1 0 1 1 0-2h1zm11.66-5.66a1 1 0 0 1 0 1.42l-.7.7a1 1 0 1 1-1.42-1.42l.7-.7a1 1 0 0 1 1.42 0zM6.46 14.46a1 1 0 0 1 0 1.42l-.7.7a1 1 0 0 1-1.42-1.42l.7-.7a1 1 0 0 1 1.42 0zM10 15a1 1 0 0 1 1 1v1a1 1 0 1 1-2 0v-1a1 1 0 0 1 1-1zm5.66-.54a1 1 0 0 1 1.42 0l.7.7a1 1 0 0 1-1.42 1.42l-.7-.7a1 1 0 0 1 0-1.42zM5.76 5.76a1 1 0 0 1-1.42 0l-.7-.7A1 1 0 1 1 5.06 3.64l.7.7a1 1 0 0 1 0 1.42z"/></svg>
        <svg viewBox="0 0 20 20" fill="currentColor" class="icon-moon"><path d="M17.3 13.6A7.5 7.5 0 0 1 7.1 4.2a1 1 0 0 0-1.2-1.3A9.5 9.5 0 1 0 18.6 14.8a1 1 0 0 0-1.3-1.2z"/></svg>
      </button>
      <input type="checkbox" id="nav-toggle" class="nav-toggle-checkbox" />
      <label for="nav-toggle" class="nav-toggle-label" aria-label="Toggle menu">
        <span></span><span></span><span></span>
      </label>
      {showTagline && site.description && <p class="site-tagline">{site.description}</p>}
      <nav class="site-nav">
        {
          navLinks.map((link) => (
            <a href={link.href} target={link.external ? "_blank" : undefined} rel={link.external ? "noopener noreferrer" : undefined}>
              {link.label}
            </a>
          ))
        }
      </nav>
    </header>
    <main class="site-main">
      <slot />
    </main>
    <footer class="site-footer" data-pagefind-ignore>
      {
        footerEntries.length > 0 && (
          <ul class="site-footer-list">
            {footerEntries.map((item) => (
              <li>
                {item.href ? (
                  <a
                    class={item.icon === "gongan" ? "site-footer-gongan" : undefined}
                    href={item.href}
                    target={item.external ? "_blank" : undefined}
                    rel={item.rel}
                  >
                    {item.icon === "gongan" && (
                      <svg viewBox="0 0 18 20" width="14" height="16" aria-hidden="true">
                        <path
                          fill="#1270e4"
                          d="M9 0 1 3v6.2C1 13.7 4.2 17.8 9 20c4.8-2.2 8-6.3 8-10.8V3L9 0z"
                        />
                        <path
                          fill="#fff"
                          d="M9 3.2c.7 1.7 1.9 3 3.6 3.8-.5 2.9-1.8 5.2-3.6 6.9-1.8-1.7-3.1-4-3.6-6.9 1.7-.8 2.9-2.1 3.6-3.8z"
                        />
                      </svg>
                    )}
                    {item.label}
                  </a>
                ) : (
                  <span>{item.label}</span>
                )}
              </li>
            ))}
          </ul>
        )
      }
    </footer>
    <script is:inline>
      (function () {
        var STORAGE_KEY = "quill-appearance";
        var btn = document.getElementById("theme-toggle");
        if (!btn) return;
        btn.addEventListener("click", function () {
          var current = document.documentElement.dataset.theme === "dark" ? "dark" : "light";
          var next = current === "dark" ? "light" : "dark";
          document.documentElement.dataset.theme = next;
          localStorage.setItem(STORAGE_KEY, next);
        });
      })();
    </script>
  </body>
</html>
