---
import { getCollection } from "astro:content";
import { gitpress, themeConfig, withBase, buildNav, mediaHref } from "../lib/gitpress";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
const site = gitpress.site;
const pageTitle = title ? `${title} · ${site.title}` : site.title;
const navPages = await getCollection("pages");
const navLinks = buildNav(navPages);
const logoHref = mediaHref(site.logo);
const avatarHref = mediaHref(site.avatar);
const showLogo = themeConfig.showLogo !== false && Boolean(logoHref);
const showAvatar = themeConfig.showAvatar === true && Boolean(avatarHref);
const showTitle = themeConfig.showTitle !== false || !showLogo;
const showTagline = themeConfig.showTagline !== false;
const faviconHref = logoHref ?? avatarHref;
---

<!doctype html>
<html lang={site.language ?? "en"} style={`--accent: ${themeConfig.accentColor}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description ?? site.description ?? ""} />
    <meta name="generator" content="GitPress" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={site.title}
      href={withBase("/rss.xml")}
    />
    {faviconHref && <link rel="icon" href={faviconHref} />}
    {site.analyticsSnippet && <Fragment set:html={site.analyticsSnippet} />}
    <script is:inline define:vars={{ defaultAppearance: themeConfig.defaultAppearance }}>
      // Runs before paint so there is no light->dark flash. Priority: the
      // visitor's own saved choice, then this site's configured default,
      // then their OS preference.
      (function () {
        var STORAGE_KEY = "quill-appearance";
        var mode = localStorage.getItem(STORAGE_KEY) || defaultAppearance;
        if (mode === "system") {
          mode = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }
        document.documentElement.dataset.theme = mode;
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="site-brand">
        {showAvatar && avatarHref && <img class="site-avatar" src={avatarHref} alt="" width="48" height="48" />}
        <div class="site-brand-copy">
          {
            showLogo && logoHref && (
              <a href={withBase("/")} class="site-logo-link">
                <img class="site-logo" src={logoHref} alt={showTitle ? "" : site.title} />
              </a>
            )
          }
          {showTitle && (
            <p class="site-title">
              <a href={withBase("/")}>{site.title}</a>
            </p>
          )}
        </div>
      </div>
      <button type="button" id="theme-toggle" class="theme-toggle" aria-label="Toggle light/dark appearance">
        <svg viewBox="0 0 20 20" fill="currentColor" class="icon-sun"><path d="M10 4a1 1 0 0 1 1 1v1a1 1 0 1 1-2 0V5a1 1 0 0 1 1-1zm0 4a4 4 0 1 1 0 8 4 4 0 0 1 0-8zm7 3a1 1 0 1 1 0 2h-1a1 1 0 1 1 0-2h1zM4 11a1 1 0 1 1 0 2H3a1 1 0 1 1 0-2h1zm11.66-5.66a1 1 0 0 1 0 1.42l-.7.7a1 1 0 1 1-1.42-1.42l.7-.7a1 1 0 0 1 1.42 0zM6.46 14.46a1 1 0 0 1 0 1.42l-.7.7a1 1 0 0 1-1.42-1.42l.7-.7a1 1 0 0 1 1.42 0zM10 15a1 1 0 0 1 1 1v1a1 1 0 1 1-2 0v-1a1 1 0 0 1 1-1zm5.66-.54a1 1 0 0 1 1.42 0l.7.7a1 1 0 0 1-1.42 1.42l-.7-.7a1 1 0 0 1 0-1.42zM5.76 5.76a1 1 0 0 1-1.42 0l-.7-.7A1 1 0 1 1 5.06 3.64l.7.7a1 1 0 0 1 0 1.42z"/></svg>
        <svg viewBox="0 0 20 20" fill="currentColor" class="icon-moon"><path d="M17.3 13.6A7.5 7.5 0 0 1 7.1 4.2a1 1 0 0 0-1.2-1.3A9.5 9.5 0 1 0 18.6 14.8a1 1 0 0 0-1.3-1.2z"/></svg>
      </button>
      <input type="checkbox" id="nav-toggle" class="nav-toggle-checkbox" />
      <label for="nav-toggle" class="nav-toggle-label" aria-label="Toggle menu">
        <span></span><span></span><span></span>
      </label>
      {showTagline && site.description && <p class="site-tagline">{site.description}</p>}
      <nav class="site-nav">
        {
          navLinks.map((link) => (
            <a href={link.href} target={link.external ? "_blank" : undefined} rel={link.external ? "noopener noreferrer" : undefined}>
              {link.label}
            </a>
          ))
        }
      </nav>
    </header>
    <main class="site-main">
      <slot />
    </main>
    <footer class="site-footer">
      <p>
        © {new Date().getFullYear()} {site.author ?? site.title} · Powered by
        <a href="https://gitpress.net" rel="generator">GitPress</a>
        · <a href={withBase("/rss.xml")}>RSS</a>
      </p>
    </footer>
    <script is:inline>
      (function () {
        var STORAGE_KEY = "quill-appearance";
        var btn = document.getElementById("theme-toggle");
        if (!btn) return;
        btn.addEventListener("click", function () {
          var current = document.documentElement.dataset.theme === "dark" ? "dark" : "light";
          var next = current === "dark" ? "light" : "dark";
          document.documentElement.dataset.theme = next;
          localStorage.setItem(STORAGE_KEY, next);
        });
      })();
    </script>
  </body>
</html>
