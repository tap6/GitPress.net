---
import Base from "../../layouts/Base.astro";
import { getPublishedPosts, postSlug, formatListDate, t, withBase } from "../../lib/gitpress";

const posts = await getPublishedPosts();
const byYear = new Map<string, typeof posts>();
for (const post of posts) {
  const year = post.data.date ? String(post.data.date.getFullYear()) : t("undated");
  const list = byYear.get(year) ?? [];
  list.push(post);
  byYear.set(year, list);
}
const years = [...byYear.entries()];
---

<Base title={t("archive")}>
  <h1 class="page-heading">{t("archive")}</h1>
  <p class="archive-count">{t("archiveCount", { n: posts.length })}</p>
  {
    years.map(([year, yearPosts]) => (
      <section class="archive-year">
        <h2>{year}</h2>
        <ul>
          {yearPosts.map((post) => (
            <li>
              <span class="archive-date">{formatListDate(post.data.date)}</span>
              <a href={withBase(`/posts/${postSlug(post)}/`)}>{post.data.title}</a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Base>
