---
import type { GetStaticPaths, Page } from "astro";
import Base from "../layouts/Base.astro";
import Pagination from "../components/Pagination.astro";
import {
  getPublishedPosts,
  postSlug,
  formatListDate,
  themeConfig,
  withBase,
  postsPerPage,
  t,
  type Post,
} from "../lib/gitpress";

// A rest parameter (`[...page]`) matches both `/` (page undefined -> page 1)
// and `/2`, `/3`, ... — this is Astro's documented pattern for making the
// homepage double as page 1 of pagination instead of a separate route.
export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPublishedPosts();
  return paginate(posts, { pageSize: postsPerPage });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<Post>;
}

const { page } = Astro.props;
---

<Base>
  {page.data.length === 0 && <p style="text-align:center">{t("emptyPosts")}</p>}
  {
    page.data.map((post) => (
      <article class="post-item">
        <p class="post-meta">
          {formatListDate(post.data.date)}
          {post.data.tags?.length ? ` · ${post.data.tags.join(", ")}` : ""}
        </p>
        <h2>
          <a href={withBase(`/posts/${postSlug(post)}/`)}>{post.data.title}</a>
        </h2>
        {themeConfig.showExcerpts && post.data.description && (
          <p class="post-excerpt">{post.data.description}</p>
        )}
      </article>
    ))
  }
  <Pagination page={page} />
</Base>
