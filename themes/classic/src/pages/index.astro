---
import Base from "../layouts/Base.astro";
import { getPublishedPosts, postSlug, formatDate, themeConfig, withBase } from "../lib/gitpress";

const posts = await getPublishedPosts();
---

<Base>
  {posts.length === 0 && <p style="text-align:center">No posts yet. Write your first one!</p>}
  {
    posts.map((post) => (
      <article class="post-item">
        <p class="post-meta">
          {formatDate(post.data.date)}
          {post.data.tags?.length ? ` · ${post.data.tags.join(", ")}` : ""}
        </p>
        <h2>
          <a href={withBase(`/posts/${postSlug(post)}/`)}>{post.data.title}</a>
        </h2>
        {themeConfig.showExcerpts && post.data.description && (
          <p class="post-excerpt">{post.data.description}</p>
        )}
      </article>
    ))
  }
</Base>
