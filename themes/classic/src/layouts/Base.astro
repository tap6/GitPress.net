---
import { getCollection } from "astro:content";
import { gitpress, themeConfig, withBase, buildNav, buildFooter, mediaHref, pageCanonicalUrl, pageAbsoluteUrl } from "../lib/gitpress";
import { GONGAN_BADGE_SRC } from "../lib/gonganBadge";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  cover?: string;
  type?: "website" | "article";
  publishedTime?: string;
}

const { title, description, cover, type = "website", publishedTime } = Astro.props;
const site = gitpress.site;
const pageTitle = title ? `${title} — ${site.title}` : site.title;
const desc = description ?? site.description ?? "";
const canonicalUrl = pageCanonicalUrl(Astro.url.pathname);
const ogImageHref = pageAbsoluteUrl(cover) ?? pageAbsoluteUrl(site.logo) ?? pageAbsoluteUrl(site.avatar);
const jsonLd =
  type === "article"
    ? {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        headline: title ?? site.title,
        description: desc || undefined,
        datePublished: publishedTime,
        image: ogImageHref,
        url: canonicalUrl,
        author: site.author ? { "@type": "Person", name: site.author } : undefined,
      }
    : {
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: site.title,
        description: desc || undefined,
        url: site.url || canonicalUrl,
      };
const navPages = await getCollection("pages");
const navLinks = buildNav(navPages);
const footerEntries = buildFooter(navPages);
const logoHref = mediaHref(site.logo);
const avatarHref = mediaHref(site.avatar);
const showLogo = themeConfig.showLogo !== false && Boolean(logoHref);
const showAvatar = themeConfig.showAvatar === true && Boolean(avatarHref);
const showTitle = themeConfig.showTitle !== false || !showLogo;
const showTagline = themeConfig.showTagline !== false;
const faviconHref = logoHref ?? avatarHref;
---

<!doctype html>
<html lang={site.language ?? "en"} style={`--accent: ${themeConfig.accentColor}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <meta name="generator" content="GitPress" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {ogImageHref && <meta property="og:image" content={ogImageHref} />}
    <meta name="twitter:card" content={ogImageHref ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={desc} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={site.title}
      href={withBase("/rss.xml")}
    />
    {faviconHref && <link rel="icon" href={faviconHref} />}
    {site.analyticsSnippet && <Fragment set:html={site.analyticsSnippet} />}
  </head>
  <body>
    <header class="site-header" data-pagefind-ignore>
      <div class="site-brand">
        {showAvatar && avatarHref && <img class="site-avatar" src={avatarHref} alt="" width="56" height="56" />}
        <div class="site-brand-copy">
          {
            showLogo && logoHref && (
              <a href={withBase("/")} class="site-logo-link">
                <img class="site-logo" src={logoHref} alt={showTitle ? "" : site.title} />
              </a>
            )
          }
          {showTitle && (
            <p class="site-title">
              <a href={withBase("/")}>{site.title}</a>
            </p>
          )}
        </div>
      </div>
      <input type="checkbox" id="nav-toggle" class="nav-toggle-checkbox" />
      <label for="nav-toggle" class="nav-toggle-label" aria-label="Toggle menu">
        <span></span><span></span><span></span>
      </label>
      {showTagline && site.description && <p class="site-tagline">{site.description}</p>}
      <nav class="site-nav">
        {
          navLinks.map((link) => (
            <a href={link.href} target={link.external ? "_blank" : undefined} rel={link.external ? "noopener noreferrer" : undefined}>
              {link.label}
            </a>
          ))
        }
      </nav>
    </header>
    <main class="site-main">
      <slot />
    </main>
    <footer class="site-footer" data-pagefind-ignore>
      {
        footerEntries.length > 0 && (
          <ul class="site-footer-list">
            {footerEntries.map((item) => (
              <li>
                {item.href ? (
                  <a
                    class={item.icon === "gongan" ? "site-footer-gongan" : undefined}
                    href={item.href}
                    target={item.external ? "_blank" : undefined}
                    rel={item.rel}
                  >
                    {item.icon === "gongan" && (
                      <img src={GONGAN_BADGE_SRC} width="15" height="16" alt="" />
                    )}
                    {item.label}
                  </a>
                ) : (
                  <span>{item.label}</span>
                )}
              </li>
            ))}
          </ul>
        )
      }
    </footer>
  </body>
</html>
