---
import { getCollection } from "astro:content";
import { gitpress, themeConfig, withBase, buildNav, buildFooter, mediaHref } from "../lib/gitpress";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
const site = gitpress.site;
const pageTitle = title ? `${title} · ${site.title}` : site.title;
const navPages = await getCollection("pages");
const navLinks = buildNav(navPages);
const footerEntries = buildFooter(navPages);
const logoHref = mediaHref(site.logo);
const avatarHref = mediaHref(site.avatar);
const showLogo = themeConfig.showLogo !== false && Boolean(logoHref);
const showAvatar = themeConfig.showAvatar === true && Boolean(avatarHref);
const showTitle = themeConfig.showTitle !== false || !showLogo;
const showTagline = themeConfig.showTagline === true;
const faviconHref = logoHref ?? avatarHref;
---

<!doctype html>
<html lang={site.language ?? "en"} style={`--accent: ${themeConfig.accentColor}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description ?? site.description ?? ""} />
    <meta name="generator" content="GitPress" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={site.title}
      href={withBase("/rss.xml")}
    />
    {faviconHref && <link rel="icon" href={faviconHref} />}
    {site.analyticsSnippet && <Fragment set:html={site.analyticsSnippet} />}
  </head>
  <body>
    <header class="site-header">
      <div class="site-brand">
        {showAvatar && avatarHref && <img class="site-avatar" src={avatarHref} alt="" width="48" height="48" />}
        <div class="site-brand-copy">
          {
            showLogo && logoHref && (
              <a href={withBase("/")} class="site-logo-link">
                <img class="site-logo" src={logoHref} alt={showTitle ? "" : site.title} />
              </a>
            )
          }
          {showTitle && (
            <p class="site-title">
              <a href={withBase("/")}>{site.title}</a>
            </p>
          )}
          {showTagline && site.description && <p class="site-tagline">{site.description}</p>}
        </div>
      </div>
      <input type="checkbox" id="nav-toggle" class="nav-toggle-checkbox" />
      <label for="nav-toggle" class="nav-toggle-label" aria-label="Toggle menu">
        <span></span><span></span><span></span>
      </label>
      <nav class="site-nav">
        {
          navLinks.map((link) => (
            <a href={link.href} target={link.external ? "_blank" : undefined} rel={link.external ? "noopener noreferrer" : undefined}>
              {link.label}
            </a>
          ))
        }
      </nav>
    </header>
    <main class="site-main">
      <slot />
    </main>
    <footer class="site-footer">
      {
        footerEntries.length > 0 && (
          <ul class="site-footer-list">
            {footerEntries.map((item) => (
              <li>
                {item.href ? (
                  <a
                    class={item.icon === "gongan" ? "site-footer-gongan" : undefined}
                    href={item.href}
                    target={item.external ? "_blank" : undefined}
                    rel={item.rel}
                  >
                    {item.icon === "gongan" && (
                      <svg viewBox="0 0 18 20" width="14" height="16" aria-hidden="true">
                        <path
                          fill="#1270e4"
                          d="M9 0 1 3v6.2C1 13.7 4.2 17.8 9 20c4.8-2.2 8-6.3 8-10.8V3L9 0z"
                        />
                        <path
                          fill="#fff"
                          d="M9 3.2c.7 1.7 1.9 3 3.6 3.8-.5 2.9-1.8 5.2-3.6 6.9-1.8-1.7-3.1-4-3.6-6.9 1.7-.8 2.9-2.1 3.6-3.8z"
                        />
                      </svg>
                    )}
                    {item.label}
                  </a>
                ) : (
                  <span>{item.label}</span>
                )}
              </li>
            ))}
          </ul>
        )
      }
    </footer>
  </body>
</html>
