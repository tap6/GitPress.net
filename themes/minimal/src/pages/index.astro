---
import Base from "../layouts/Base.astro";
import { getPublishedPosts, postSlug, themeConfig, withBase } from "../lib/gitpress";

const posts = await getPublishedPosts();

function shortDate(date: Date | undefined): string {
  if (!date) return "";
  return date.toISOString().slice(0, 10);
}
---

<Base>
  {posts.length === 0 && <p>No posts yet. Write your first one!</p>}
  {
    posts.map((post) => (
      <article class="post-item">
        <p class="post-meta">{shortDate(post.data.date)}</p>
        <h2>
          <a href={withBase(`/posts/${postSlug(post)}/`)}>{post.data.title}</a>
        </h2>
        {themeConfig.showExcerpts && post.data.description && (
          <p class="post-excerpt">{post.data.description}</p>
        )}
      </article>
    ))
  }
</Base>
