---
import Base from "../../layouts/Base.astro";
import { getPublishedPosts, postSlug, formatListDate, withBase, type Post } from "../../lib/gitpress";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const byTag = new Map<string, Post[]>();
  for (const post of posts) {
    for (const tag of post.data.tags ?? []) {
      const list = byTag.get(tag) ?? [];
      list.push(post);
      byTag.set(tag, list);
    }
  }
  return [...byTag.entries()].map(([tag, tagged]) => ({
    params: { tag },
    props: { tag, posts: tagged },
  }));
}

interface Props {
  tag: string;
  posts: Post[];
}

const { tag, posts } = Astro.props;
---

<Base title={`#${tag}`}>
  <h1 class="page-heading">#{tag}</h1>
  {
    posts.map((post) => (
      <article class="post-item">
        <p class="post-meta">{formatListDate(post.data.date)}</p>
        <h2>
          <a href={withBase(`/posts/${postSlug(post)}/`)}>{post.data.title}</a>
        </h2>
      </article>
    ))
  }
</Base>
