{
  "name": "@gitpress/spec",
  "version": "1.0.0",
  "description": "GitPress spec v1: JSON Schemas and TypeScript types for gitpress.json, theme.json, and the content/frontmatter conventions.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schemas/gitpress.schema.json": "./schemas/gitpress.schema.json",
    "./schemas/theme.schema.json": "./schemas/theme.schema.json"
  },
  "files": [
    "src",
    "schemas",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
