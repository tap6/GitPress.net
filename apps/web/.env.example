# ---------------------------------------------------------------------------
# GitPress.net platform environment
# Copy to .env.local and fill in. Providers with missing credentials are
# simply hidden from the login page, so you can start with just one.
# ---------------------------------------------------------------------------

# Postgres (Neon / Supabase / any). Used only for metadata — never content.
DATABASE_URL="postgres://user:password@host:5432/gitpress"

# Auth.js
AUTH_SECRET="generate with: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"

# Quick login providers (each pair optional)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_TWITTER_ID=""
AUTH_TWITTER_SECRET=""

# GitHub App (repository orchestration — separate from GitHub login above)
# Create at: GitHub Settings → Developer settings → GitHub Apps
#   - Callback/Setup URL: {AUTH_URL}/api/github/setup   (check "Request user
#     authorization (OAuth) during installation", uncheck token expiration)
#   - Repository permissions: Administration RW, Contents RW, Pages RW,
#     Secrets RW, Workflows RW, Metadata R
GITHUB_APP_ID=""
GITHUB_APP_SLUG=""
GITHUB_APP_PRIVATE_KEY=""   # PEM, newlines as \n
GITHUB_APP_CLIENT_ID=""
GITHUB_APP_CLIENT_SECRET=""

# Where builtin themes + the build action live (open-source repos)
GITPRESS_THEMES_REPO="gitpress-net/gitpress"
GITPRESS_BUILD_ACTION_REPO="gitpress-net/build-action"
